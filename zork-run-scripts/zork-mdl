#!/bin/sh
set -eu

script=$(readlink -f -- "$0")
bin_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd -P)
prefix=$(CDPATH= cd -- "$bin_dir/.." && pwd -P)

share="$prefix/share/zork-vaxum-mdl"

if [ ! -t 0 ] || [ ! -t 1 ]; then
    if ! command -v xdg-terminal-exec >/dev/null 2>&1; then
        printf '%s\n' \
            'No terminal is attached and xdg-terminal-exec is unavailable.' \
            'Run this launcher from a terminal or install xdg-terminal-exec.' >&2
        exit 1
    fi

    exec xdg-terminal-exec \
        --title='Zork: Vaxum MDL' \
        -- "$0" "$@"
fi

if ! mdli=$(command -v mdli); then
    printf '%s\n' \
        'MDL interpreter not found: mdli is not available on PATH.' \
        'Install zork-vaxum-mdl or make mdli available on PATH.' >&2
    exit 1
fi

export ZORK_VAXUM_MDL_PREFIX="$prefix"
export ZORK_VAXUM_MDL_SHARE="$share"
export ZORK_VAXUM_MDL_EXPECT="$prefix/libexec/zork-vaxum-mdl/expect"
export ZORK_VAXUM_MDL_DATA_ROOT="${XDG_DATA_HOME:-${HOME:?}/.local/share}/zork-vaxum-mdl"
export ZORK_VAXUM_MDL_TIMESTAMP
ZORK_VAXUM_MDL_TIMESTAMP=$(date '+%Y%m%d-%H%M%S')

exec "$mdli" -f "$share/zorkmenu.mud" "$@"

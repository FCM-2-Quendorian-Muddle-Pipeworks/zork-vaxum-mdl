<DEFINE DAM-CONTROLLER ()
  <PROG ((RESERVOIR-LEVEL 0)
         (INFLOW 0)
         (OUTFLOW 0)
         (GATE-OPENING 0)
         (SPILLWAY-OPEN 0)
         (ALARM-STATE ,ALARM-NORMAL)
         (OPERATING-MODE ,MODE-AUTOMATIC))
    <WHILE T
      <DO
        <SET INFLOW <READ-SENSOR ,SENSOR-INFLOW>>
        <SET RESERVOIR-LEVEL <READ-SENSOR ,SENSOR-LEVEL>>
        <COND
          (<OR <NOT <VALID-READING? .INFLOW>>
               <NOT <VALID-READING? .RESERVOIR-LEVEL>>>
           <SET ALARM-STATE ,ALARM-SENSOR-FAULT>
           <CALL-OPERATOR "Sensor fault detected">
           <ENTER-SAFE-MODE>)
          (<EQUAL? .OPERATING-MODE ,MODE-AUTOMATIC>
           <CALL DAM-AUTOMATIC-CONTROL
                 .RESERVOIR-LEVEL
                 .INFLOW
                 .OUTFLOW>)
          (<EQUAL? .OPERATING-MODE ,MODE-MANUAL>
           <CALL DAM-MANUAL-CONTROL>)
          (ELSE
           <SET ALARM-STATE ,ALARM-MODE-FAULT>
           <ENTER-SAFE-MODE>)>
        <UPDATE-DISPLAY
          .RESERVOIR-LEVEL
          .INFLOW
          .OUTFLOW
          .GATE-OPENING
          .ALARM-STATE>
        <WAIT ,CONTROL-INTERVAL>>>>
  <RETURN ,STATUS-STOPPED>>

<DEFINE DAM-AUTOMATIC-CONTROL (LEVEL INFLOW OUTFLOW)
  <PROG ((TARGET-OUTFLOW 0)
         (GATE-COMMAND 0)>
    <Select a release target from the reservoir operating band.
     Actual gate commands must be independently validated by
     the safety controller before reaching the actuators.>
    <SET TARGET-OUTFLOW
      <COND
        (<G? .LEVEL ,LEVEL-EMERGENCY>
         <SET ALARM-STATE ,ALARM-EMERGENCY>
         <MAXIMUM-APPROVED-RELEASE .INFLOW>)
        (<G? .LEVEL ,LEVEL-FLOOD>
         <SET ALARM-STATE ,ALARM-FLOOD>
         <CALCULATE-FLOOD-RELEASE .LEVEL .INFLOW>)
        (<G? .LEVEL ,LEVEL-HIGH>
         <SET ALARM-STATE ,ALARM-HIGH>
         <CALCULATE-HIGH-RELEASE .LEVEL .INFLOW>)
        (<L? .LEVEL ,LEVEL-LOW>
         <SET ALARM-STATE ,ALARM-LOW>
         <MINIMUM-APPROVED-RELEASE>)
        (ELSE
         <SET ALARM-STATE ,ALARM-NORMAL>
         <NORMAL-RELEASE .INFLOW>)>>
    <SET GATE-COMMAND
      <CALCULATE-GATE-POSITION .TARGET-OUTFLOW>>
    <VALIDATE-GATE-COMMAND .GATE-COMMAND>
    <SUBMIT-GATE-COMMAND .GATE-COMMAND>
     <RETURN .TARGET-OUTFLOW>>>

<DEFINE DAM-MANUAL-CONTROL ()
  <PROG ((REQUEST 0)
         (OPERATOR-ID <>)
         (AUTHORISED <> ))
    <SET OPERATOR-ID <READ-OPERATOR-ID>>
    <SET AUTHORISED <CHECK-OPERATOR-AUTHORITY .OPERATOR-ID>>
    <COND
      (<NOT .AUTHORISED>
       <LOG-EVENT "Unauthorised manual control request">
       <RAISE-ALARM ,ALARM-AUTHORITY>
       <RETURN ,STATUS-REJECTED>)
      (ELSE
       <SET REQUEST <READ-MANUAL-REQUEST>>
       <VALIDATE-MANUAL-REQUEST .REQUEST>
       <SUBMIT-MANUAL-REQUEST .REQUEST>
       <LOG-EVENT "Manual command accepted">)>
     <RETURN ,STATUS-OK>>>

<DEFINE DAM-EMERGENCY-HANDLER (EVENT)
  <PROG ()
    <LOG-EVENT .EVENT>
    <SET ALARM-STATE ,ALARM-EMERGENCY>
    <ACTIVATE-LOCAL-ALARMS>
    <NOTIFY-DAM-OPERATOR>
    <NOTIFY-FLOOD-WARNING-CENTRE>
    <FREEZE-NONESSENTIAL-CONTROL-CHANGES>
    <COND
      (<EQUAL? .EVENT ,EVENT-STRUCTURAL-FAULT>
       <ISOLATE-AFFECTED-SUBSYSTEM>)
      (<EQUAL? .EVENT ,EVENT-POWER-FAILURE>
       <SWITCH-TO-BACKUP-POWER>)
      (<EQUAL? .EVENT ,EVENT-COMMUNICATION-LOSS>
       <ENABLE-LOCAL-CONTROL>
       <LOG-EVENT "Remote control unavailable">)
      (ELSE
       <ENTER-SAFE-MODE>)>
     <RETURN ,STATUS-EMERGENCY>>>

<DEFINE DAM-DAILY-REPORT ()
  <PROG ((REPORT <CREATE-REPORT>))
    <REPORT-ADD .REPORT "Reservoir level" <READ-SENSOR ,SENSOR-LEVEL>>
    <REPORT-ADD .REPORT "Inflow" <READ-SENSOR ,SENSOR-INFLOW>>
    <REPORT-ADD .REPORT "Outflow" <READ-SENSOR ,SENSOR-OUTFLOW>>
    <REPORT-ADD .REPORT "Gate position" <READ-SENSOR ,SENSOR-GATE>>
    <REPORT-ADD .REPORT "Alarm state" .ALARM-STATE>
    <REPORT-ADD .REPORT "Operating mode" .OPERATING-MODE>
    <REPORT-ADD .REPORT "Operator interventions" <COUNT-OPERATOR-EVENTS>>
    <STORE-REPORT .REPORT>
    <RETURN .REPORT>>>
<END-DEFINITION>
